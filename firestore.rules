rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Fonctions communes
    // ------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // Administrateur : document admins/{uid} (créé depuis la console
    // Firebase ou par un autre administrateur).
    function isAdmin() {
      return signedIn() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Compte bloqué/supprimé par un administrateur : plus aucune création.
    function isBlockedUser() {
      return exists(/databases/$(database)/documents/userModeration/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/userModeration/$(request.auth.uid)).data.get('blocked', false) == true;
    }

    function active() {
      return signedIn() && !isBlockedUser();
    }

    function org(id) {
      return get(/databases/$(database)/documents/organisations/$(id)).data;
    }

    // Organisation appartenant à l'utilisateur et non bloquée.
    function ownsUsableOrg(id) {
      return org(id).ownerId == request.auth.uid &&
             org(id).get('blocked', false) != true;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ------------------------------------------------------------------
    // Administration
    // ------------------------------------------------------------------

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Blocage / suppression d'un compte (lu par l'app au démarrage).
    match /userModeration/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Journal des actions des administrateurs.
    match /adminLogs/{logId} {
      allow read, create: if isAdmin();
    }

    // Compteur séquentiel des demandes de retrait (RET-000001, ...).
    match /counters/withdrawals {
      allow read: if signedIn();
      allow create: if active() && request.resource.data.next == 2;
      allow update: if isAdmin() ||
                       (active() && request.resource.data.next == resource.data.next + 1);
    }

    // ------------------------------------------------------------------
    // Utilisateurs
    // ------------------------------------------------------------------

    // Profil utilisateur + sous-collections privées/liées.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if signedIn() && request.auth.uid == userId;
      allow update, delete: if isAdmin();

      // Publications sauvegardées par l'utilisateur (miroir de posts/{id}/saves).
      match /saves/{postId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Comptes que l'utilisateur suit.
      match /following/{targetUserId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Abonnés de l'utilisateur : chaque entrée est créée par l'abonné.
      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == followerId;
      }

      // Événements aimés (favoris) — miroir de events/{id}/likes.
      match /likedEvents/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Organisations suivies — miroir de organisations/{id}/followers.
      match /followedOrganisations/{organisationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Notifications envoyées par l'administrateur (temps réel dans
      // l'app). L'utilisateur peut seulement les marquer lues/supprimer.
      match /notifications/{notificationId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow update: if signedIn() && request.auth.uid == userId &&
                         changedKeys().hasOnly(['read']);
        allow create: if isAdmin();
      }
    }

    // ------------------------------------------------------------------
    // Fil "Posts" (photo/vidéo façon reels)
    // ------------------------------------------------------------------

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if active() &&
                       request.resource.data.authorId == request.auth.uid;
      // Mise à jour : l'auteur (édition) ou n'importe quel utilisateur
      // connecté pour les compteurs (like/commentaire/sauvegarde/partage/
      // republication), gérés via transaction côté client.
      allow update: if request.auth != null;
      allow delete: if isAdmin() ||
                       (request.auth != null && resource.data.authorId == request.auth.uid);

      match /likes/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /votes/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /saves/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if active() &&
                         request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAdmin() ||
                         (request.auth != null && resource.data.authorId == request.auth.uid);
      }
    }

    // ------------------------------------------------------------------
    // Organisations
    // ------------------------------------------------------------------

    // `certified` et `blocked` ne sont modifiables que par un
    // administrateur : une organisation naît non certifiée et non bloquée.
    match /organisations/{organisationId} {
      allow read: if request.auth != null;
      allow create: if active() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.get('certified', false) == false &&
                       request.resource.data.get('blocked', false) == false;
      // Le propriétaire modifie ses infos (et peut demander la
      // certification) sans toucher aux champs d'administration ;
      // n'importe quel utilisateur connecté peut ajuster le compteur
      // d'abonnés (transaction d'abonnement).
      allow update: if isAdmin() ||
                       (request.auth != null &&
                        resource.data.ownerId == request.auth.uid &&
                        !changedKeys().hasAny(['certified', 'certifiedAt', 'blocked', 'blockedReason', 'blockedAt'])) ||
                       (request.auth != null && changedKeys().hasOnly(['followerCount']));
      allow delete: if isAdmin() ||
                       (request.auth != null && resource.data.ownerId == request.auth.uid);

      match /followers/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ------------------------------------------------------------------
    // Événements (billetterie)
    // ------------------------------------------------------------------

    match /events/{eventId} {
      allow read: if request.auth != null;
      // Création : organisation de l'utilisateur, non bloquée ; le badge
      // "certifié" recopié doit correspondre à l'organisation.
      allow create: if active() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       ownsUsableOrg(request.resource.data.organisationId) &&
                       request.resource.data.get('hiddenByAdmin', false) == false &&
                       request.resource.data.get('organisationCertified', false) ==
                         org(request.resource.data.organisationId).get('certified', false);
      // Le propriétaire modifie tout sauf les champs d'administration ;
      // le public peut seulement faire évoluer les compteurs (vues,
      // j'aime, boosts) ; l'administrateur peut tout modifier.
      allow update: if isAdmin() ||
                       (request.auth != null &&
                        resource.data.ownerId == request.auth.uid &&
                        !changedKeys().hasAny(['hiddenByAdmin', 'organisationCertified'])) ||
                       (request.auth != null &&
                        changedKeys().hasOnly(['views', 'likeCount', 'boosts', 'boostAmount']));
      allow delete: if isAdmin() ||
                       (request.auth != null && resource.data.ownerId == request.auth.uid);

      match /likes/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // Types de billets : lecture publique (prix affichés au public).
      // Création/suppression/modification des champs (nom, prix,
      // quantité) réservées au propriétaire de l'événement ; n'importe
      // quel utilisateur connecté peut en revanche incrémenter
      // `quantitySold` (fait côté client, dans la transaction qui
      // confirme sa propre commande — aucune passerelle serveur n'est
      // branchée), à condition de ne toucher que ce champ.
      match /ticketTypes/{ticketTypeId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null &&
                        get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid;
        allow update: if request.auth != null &&
                        (get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid ||
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantitySold']));
      }

      // Codes promo : lecture publique (validation au checkout). Même
      // logique que les types de billets : seul le propriétaire crée ou
      // supprime un code, mais la confirmation d'une commande (côté
      // acheteur) peut incrémenter `usedCount`.
      match /promoCodes/{code} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null &&
                        get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid;
        allow update: if request.auth != null &&
                        (get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid ||
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']));
      }
    }

    // ------------------------------------------------------------------
    // Votes
    // ------------------------------------------------------------------

    // Campagnes de vote payant d'une organisation.
    match /voteCampaigns/{campaignId} {
      allow read: if request.auth != null;
      allow create: if active() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       ownsUsableOrg(request.resource.data.organisationId) &&
                       request.resource.data.get('hiddenByAdmin', false) == false &&
                       request.resource.data.get('organisationCertified', false) ==
                         org(request.resource.data.organisationId).get('certified', false);
      allow update: if isAdmin() ||
                       (request.auth != null &&
                        resource.data.ownerId == request.auth.uid &&
                        !changedKeys().hasAny(['hiddenByAdmin', 'organisationCertified']));
      allow delete: if isAdmin() ||
                       (request.auth != null && resource.data.ownerId == request.auth.uid);

      // Catégories : lecture publique (prix par vote affiché), gestion
      // réservée au propriétaire de la campagne.
      match /categories/{categoryId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null &&
                        get(/databases/$(database)/documents/voteCampaigns/$(campaignId)).data.ownerId == request.auth.uid;

        // Candidats : lecture publique. Création/suppression réservées
        // au propriétaire ; n'importe quel utilisateur connecté peut en
        // revanche incrémenter `voteCount` (fait côté client, dans la
        // transaction qui confirme son propre achat de votes — aucune
        // passerelle serveur n'est branchée), à condition de ne toucher
        // que ce champ.
        match /candidates/{candidateId} {
          allow read: if request.auth != null;
          allow create, delete: if request.auth != null &&
                          get(/databases/$(database)/documents/voteCampaigns/$(campaignId)).data.ownerId == request.auth.uid;
          allow update: if request.auth != null &&
                          (get(/databases/$(database)/documents/voteCampaigns/$(campaignId)).data.ownerId == request.auth.uid ||
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCount']));
        }
      }
    }

    // Achats de votes (Orange Money / MTN Mobile Money simulés). Le
    // champ `ownerId` (propriétaire de la campagne au moment de l'achat)
    // est dupliqué sur la commande pour éviter un get() imbriqué dans
    // les règles — plus robuste si la campagne est supprimée ensuite.
    match /voteOrders/{orderId} {
      allow read: if isAdmin() ||
                     (request.auth != null &&
                      (resource.data.buyerId == request.auth.uid ||
                       resource.data.ownerId == request.auth.uid));
      allow create: if active() &&
                       request.resource.data.buyerId == request.auth.uid;
      allow update: if request.auth != null &&
                       resource.data.buyerId == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // Argent : boosts, retraits, commandes, billets
    // ------------------------------------------------------------------

    // Boosts d'événements (paiement Mobile Money simulé, 100 F minimum).
    match /eventBoosts/{boostId} {
      allow read: if isAdmin() ||
                     (request.auth != null &&
                      (resource.data.buyerId == request.auth.uid ||
                       resource.data.ownerId == request.auth.uid));
      allow create: if active() &&
                       request.resource.data.buyerId == request.auth.uid &&
                       request.resource.data.amount >= 100;
    }

    // Demandes de retrait des gains d'une organisation (Mobile Money).
    // Seule une organisation certifiée et non bloquée peut en créer ;
    // chaque demande porte le numéro séquentiel suivant du compteur
    // `counters/withdrawals`. L'administrateur la fait avancer
    // (pending -> approved -> paid, ou rejected) ; le propriétaire peut
    // seulement l'annuler tant qu'elle est en attente. Aucune passerelle
    // de paiement sortant n'est branchée : l'admin paie manuellement.
    match /withdrawals/{withdrawalId} {
      allow read: if isAdmin() ||
                     (request.auth != null && resource.data.ownerId == request.auth.uid);
      allow create: if active() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.amount > 0 &&
                       org(request.resource.data.organisationId).ownerId == request.auth.uid &&
                       org(request.resource.data.organisationId).get('certified', false) == true &&
                       org(request.resource.data.organisationId).get('blocked', false) != true &&
                       getAfter(/databases/$(database)/documents/counters/withdrawals).data.next ==
                         request.resource.data.number + 1;
      allow update: if isAdmin() ||
                       (request.auth != null &&
                        resource.data.ownerId == request.auth.uid &&
                        resource.data.status == 'pending' &&
                        request.resource.data.status == 'cancelled' &&
                        changedKeys().hasOnly(['status', 'cancelledAt']));
      allow delete: if isAdmin();
    }

    // Commandes de billets (Orange Money / MTN Mobile Money simulés). Le
    // champ `ownerId` (propriétaire de l'événement au moment de l'achat)
    // est dupliqué sur la commande pour éviter un get() imbriqué dans
    // les règles — plus robuste si l'événement est supprimé ensuite, et
    // c'est ce qui permet au portefeuille de l'organisation de lire
    // toutes ses commandes sans crainte de permission-denied.
    match /orders/{orderId} {
      allow read: if isAdmin() ||
                     (request.auth != null &&
                      (resource.data.buyerId == request.auth.uid ||
                       resource.data.ownerId == request.auth.uid));
      allow create: if active() &&
                       request.resource.data.buyerId == request.auth.uid;
      // Confirmation du paiement (pending -> confirmed) par l'acheteur
      // lui-même : aucune passerelle serveur n'est branchée.
      allow update: if request.auth != null &&
                       resource.data.buyerId == request.auth.uid;
    }

    // Billets individuels, générés à la confirmation d'une commande.
    match /tickets/{ticketId} {
      allow read: if isAdmin() ||
                     (request.auth != null &&
                      (resource.data.buyerId == request.auth.uid ||
                       resource.data.ownerId == request.auth.uid));
      allow create: if request.auth != null &&
                       request.resource.data.buyerId == request.auth.uid;
      // Check-in à l'entrée : réservé au propriétaire de l'événement.
      allow update: if request.auth != null &&
                       resource.data.ownerId == request.auth.uid;
    }
  }
}
